generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
} 

model Task {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   DateTime @default(now())
  completed   Boolean  @default(false)
}

model Note {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model Reminder {
  id        Int      @id @default(autoincrement())
  content   String
  datetime  DateTime?
  createdAt DateTime @default(now())
}


model Command {
  id        Int      @id @default(autoincrement())
  action    String
  type      String
  content   String
  createdAt DateTime @default(now())
}
